# macOS
.DS_Store

# ── Node / Husky ─────────────────────────────────────────────
# package.json và package-lock.json thì VẪN COMMIT — bạn cùng nhóm cần chúng
# để chạy `npm install` và nhận được git hook.
node_modules/

# .husky/_/ là thư mục husky tự sinh ra. Bản thân husky có đặt một .gitignore
# bên trong đó, nhưng khai báo ở đây để không phụ thuộc vào file đó.
.husky/_/

# ── Java / Maven ─────────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.log

# ── Dart / Flutter ───────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
**/build/
*.iml

# Android
**/android/.gradle/
**/android/local.properties
**/android/key.properties
*.jks
*.keystore

# iOS
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/

# ── IDE & công cụ ────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.claude/

# ── Bí mật ───────────────────────────────────────────────────
.env
.env.local
